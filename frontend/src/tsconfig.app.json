{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "outDir": "../out-tsc/app",
    "baseUrl": "./",
    "module": "esnext",
    "types": [
      "node",
    ],
    "typeRoots": [ "../node_modules/@types" ],
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "noUnusedLocals": false
  },
  "exclude": [
    "test.ts",
    "environments/*.ts",
    "**/*.spec.ts"
  ],
  "files": [
    "main.server.ts",
    "server.ts",
    "main.ts",
    "polyfills.ts"
  ]
}
